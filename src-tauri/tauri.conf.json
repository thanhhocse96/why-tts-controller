{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceFactory",
  "version": "0.0.1",
  "identifier": "local.voicefactory.desktop",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VoiceFactory",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "url": "http://127.0.0.1:3000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
